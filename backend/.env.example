# 复制为 backend/.env 后生效

# 留空 => 内存仓库（直接读 data/*.geojson，零依赖启动）
DATABASE_URL=

# PostGIS 示例（先 docker compose up -d postgis && python backend/scripts/load_postgis.py）
# DATABASE_URL=postgresql://park:park@localhost:5432/park_twin

# GeoServer 仅在需要对外提供 OGC WMS/WFS 时填写
GEOSERVER_URL=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TELEMETRY_INTERVAL=2.0
CACHE_TTL_SECONDS=30
DEFAULT_LOD=1
